{
  "name": "unblocked-hub",
  "version": "3.0.0",
  "private": true,
  "description": "Student hub using Scramjet 2 with Wisp/libcurl transport.",
  "type": "module",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs && node scripts/build-client.mjs",
    "build-client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@fastify/static": "9.0.0",
    "@mercuryworkshop/libcurl-transport": "2.0.5",
    "@mercuryworkshop/proxy-transports": "1.0.2",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v2.0.67-alpha.2/mercuryworkshop-scramjet-2.0.67-alpha.2.tgz",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/scramjet-utils": "0.0.3",
    "@mercuryworkshop/wisp-js": "0.4.1",
    "dotenv": "17.4.2",
    "fastify": "5.7.4",
    "ws": "8.18.3",
    "esbuild": "0.25.9"
  },
  "packageManager": "pnpm@10.18.3"
}
